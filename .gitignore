# ==========================================
# M365-Toolkit - Git Ignore Rules
# ==========================================

# --- Client Data & Generated Reports ---
*.csv
*.xlsx
*.xls
*.json
!*.config.json
!*.example.json
*.kql.txt

# --- Database & Backups ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.zip
*.7z
*.tar.gz
*.pst
*.ost
*.msg
*.eml
backups/

# --- Output Directory ---
output/*
!output/.gitkeep

# --- Credentials & Sensitive Secrets ---
*.pfx
*.cer
*.crt
*.pem
*.key
*.credential
*.secret
.env
.env.*

# --- PowerShell Logs & History ---
*.log
*transcript*.txt
PSScriptAnalyzerSettings.psd1

# --- OS & Editor Metadata ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
